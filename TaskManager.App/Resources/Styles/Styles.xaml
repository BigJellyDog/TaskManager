<?xml version="1.0" encoding="UTF-8" ?>
<!-- Styles of the Signal design. Colours come from the theme dictionary (DarkTheme/LightTheme.xaml) through DynamicResource,
     so everything is recoloured by itself on a theme change. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:String x:Key="MonoFont">Segoe UI Variable</x:String>

    <x:Double x:Key="RadiusSm">8</x:Double>
    <x:Double x:Key="RadiusMd">12</x:Double>
    <x:Double x:Key="RadiusLg">18</x:Double>

    <!-- ===== Base elements ===== -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource Line}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- The primary button: lime (dark theme) or olive (light theme), one per screen. -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource PageGlow}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Side}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Ink}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <!-- ===== Text styles of the design ===== -->

    <!-- The task title in the list. -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Captions, status, tags, deadline in a row. -->
    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
    </Style>

    <Style x:Key="MicroLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
    </Style>

    <!-- Service labels: panel and column headers, dates, numbers. In the Aurora design a normal font and lower case. -->
    <Style x:Key="MonoLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
    </Style>

    <!-- The metric figure on the statistics screen. -->
    <Style x:Key="MetricLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- The loading screen. -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- A card or panel: a surface with a thin border and a radius of 8. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardGradient}" />
        <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- We do not show scroll bars: scrolling with the mouse wheel works, and the Signal mockup has no bar. -->
    <Style TargetType="ScrollView">
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
    </Style>

</ResourceDictionary>
