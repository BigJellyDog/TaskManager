<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
             xmlns:loc="clr-namespace:TaskManager.App.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             x:Class="TaskManager.App.Pages.DataPage"
             x:DataType="vm:DataViewModel"
             Title="{loc:Extension 'Данные'}">

    <ContentPage.Resources>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="Label" BasedOn="{StaticResource MonoLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.6" />
        </Style>
        <Style x:Key="PanelNote" TargetType="Label" BasedOn="{StaticResource MicroLabel}">
            <Setter Property="LineHeight" Value="1.15" />
        </Style>
        <!-- Строка действия: название слева, кнопки справа -->
        <Style x:Key="ActionRow" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 5" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
            <Setter Property="Padding" Value="12,6,6,6" />
        </Style>
        <Style x:Key="ActionName" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto" RowSpacing="14" Padding="28,20,28,14">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{loc:Extension 'Данные'}" FontSize="20" FontAttributes="Bold" TextTransform="Uppercase" CharacterSpacing="1.6" />
                    <Label Text="{loc:Extension 'Экспорт · резервная копия · импорт'}" Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0.7" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Резервная копия -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}" Stroke="{DynamicResource AccentBrush}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Extension 'Резервная копия'}" Style="{StaticResource PanelTitle}" />
                        <Label Text="{loc:Extension 'Копия всей базы: история, теги, повторения, напоминания.'}" Style="{StaticResource PanelNote}" />
                        <Border Style="{StaticResource ActionRow}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <Label Text="{loc:Extension 'Создать копию'}" Style="{StaticResource ActionName}" />
                                <controls:SignalButton Grid.Column="1" Variant="Primary" Compact="True" Text="{loc:Extension 'В «Документы»'}" Command="{Binding BackupQuickCommand}" />
                                <controls:SignalButton Grid.Column="2" Compact="True" Text="{loc:Extension 'Сохранить как…'}" Command="{Binding BackupAsCommand}" />
                            </Grid>
                        </Border>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding HasStatus}">
                            <controls:Icon Kind="check" Size="14" Color="{DynamicResource SDone}" />
                            <Label Text="{Binding StatusMessage}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   TextColor="{DynamicResource SDone}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <Label Text="{loc:Extension 'Показать в папке'}" IsVisible="{Binding HasSavedPath}" FontSize="12" TextColor="{DynamicResource Accent}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RevealSavedCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Экспорт -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Extension 'Экспорт'}" Style="{StaticResource PanelTitle}" />
                        <Label Text="{loc:Extension 'JSON — для переноса и импорта, Markdown — для чтения. История не экспортируется.'}" Style="{StaticResource PanelNote}" />
                        <HorizontalStackLayout Spacing="10">
                            <controls:SwitchToggle IsOn="{Binding IncludeDeleted}" />
                            <Label Text="{loc:Extension 'Включить удалённые задачи'}" FontSize="13" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource ActionRow}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <Label Text="JSON" Style="{StaticResource ActionName}" />
                                <controls:SignalButton Grid.Column="1" Compact="True" Text="{loc:Extension 'В «Документы»'}" Command="{Binding ExportJsonQuickCommand}" />
                                <controls:SignalButton Grid.Column="2" Compact="True" Text="{loc:Extension 'Сохранить как…'}" Command="{Binding ExportJsonAsCommand}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource ActionRow}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <Label Text="Markdown" Style="{StaticResource ActionName}" />
                                <controls:SignalButton Grid.Column="1" Compact="True" Text="{loc:Extension 'В «Документы»'}" Command="{Binding ExportMarkdownQuickCommand}" />
                                <controls:SignalButton Grid.Column="2" Compact="True" Text="{loc:Extension 'Сохранить как…'}" Command="{Binding ExportMarkdownAsCommand}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Восстановление -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Stroke="{DynamicResource PCritBrush}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Extension 'Восстановление'}" Style="{StaticResource PanelTitle}" TextColor="{DynamicResource PCrit}" />
                        <Label Text="{loc:Extension 'Заменит текущие данные и применится после перезапуска. Прежняя база сохранится как страховочная копия.'}"
                               Style="{StaticResource PanelNote}" />
                        <Border Style="{StaticResource ActionRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="{loc:Extension 'Восстановить из копии…'}" Style="{StaticResource ActionName}" />
                                <controls:SignalButton Grid.Column="1" Compact="True" Variant="Danger" Icon="undo" Text="{loc:Extension 'Выбрать файл'}" Command="{Binding RestoreCommand}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Импорт -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Extension 'Импорт'}" Style="{StaticResource PanelTitle}" />
                        <Label Text="{loc:Extension 'Новые задачи добавляются к существующим, повторы (то же название и дедлайн) пропускаются.'}" Style="{StaticResource PanelNote}" />
                        <Border Style="{StaticResource ActionRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="{loc:Extension 'Файл JSON'}" Style="{StaticResource ActionName}" />
                                <controls:SignalButton Grid.Column="1" Compact="True" Text="{loc:Extension 'Выбрать файл…'}" Command="{Binding ImportCommand}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding HasImportReport}" Spacing="4">
                            <HorizontalStackLayout Spacing="22" Margin="0,0,0,4">
                                <VerticalStackLayout>
                                    <Label Text="{loc:Extension 'Добавлено'}" Style="{StaticResource MonoLabel}" FontSize="12" />
                                    <Label Text="{Binding ImportAdded}" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="{loc:Extension 'Пропущено'}" Style="{StaticResource MonoLabel}" FontSize="12" />
                                    <Label Text="{Binding ImportSkipped}" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="{loc:Extension 'Ошибок'}" Style="{StaticResource MonoLabel}" FontSize="12" />
                                    <Label Text="{Binding ImportErrors}" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="{loc:Extension 'Предупреждений'}" Style="{StaticResource MonoLabel}" FontSize="12" />
                                    <Label Text="{Binding ImportWarnings}" FontSize="16" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ImportIssues}" Spacing="3">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImportIssueRowViewModel">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Kind}" TextColor="{Binding Color}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10" FontAttributes="Bold" TextTransform="Uppercase" CharacterSpacing="0.6" WidthRequest="84" VerticalOptions="Center" />
                                            <Label Text="{Binding Text}" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Демо-данные -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Panel}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{loc:Extension 'Демо-данные'}" FontSize="13" FontAttributes="Bold" />
                            <Label Text="{loc:Extension 'Набор примеров с тегом «демо»: ваши задачи не затрагиваются.'}" Style="{StaticResource PanelNote}" />
                        </VerticalStackLayout>
                        <controls:SignalButton Grid.Column="1" Compact="True" Text="{loc:Extension 'Заполнить демо-данными'}" Command="{Binding SeedDemoCommand}" />
                        <controls:SignalButton Grid.Column="2" Compact="True" Variant="Danger" Text="{loc:Extension 'Удалить демо-данные'}" Command="{Binding RemoveDemoCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>
