<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
             xmlns:loc="clr-namespace:TaskManager.App.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             x:Class="TaskManager.App.Pages.StatisticsPage"
             x:DataType="vm:StatisticsViewModel"
             Title="{loc:Extension 'Статистика'}">

    <ContentPage.Resources>
        <!-- A tile with a figure -->
        <Style x:Key="MetricTile" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="MetricCaption" TargetType="Label" BasedOn="{StaticResource MonoLabel}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="0.6" />
        </Style>
        <Style x:Key="MetricValue" TargetType="Label" BasedOn="{StaticResource MetricLabel}">
            <Setter Property="FontSize" Value="28" />
        </Style>
        <Style x:Key="MetricNote" TargetType="Label" BasedOn="{StaticResource MicroLabel}">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="Label" BasedOn="{StaticResource MonoLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.6" />
        </Style>
        <Style x:Key="ChartValue" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="PeriodItem" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 3" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Padding="28,20,28,14">

        <!-- Header, period switch, refresh -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="{loc:Extension 'Статистика'}" FontSize="30" FontAttributes="Bold" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0.7" />
            </VerticalStackLayout>

            <Border Grid.Column="1" BackgroundColor="{DynamicResource SurfaceRaised}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" Padding="3" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="2">
                    <Border Style="{StaticResource PeriodItem}">
                        <Label Text="{loc:Extension '7 дней'}" FontSize="13" TextColor="{DynamicResource InkMuted}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsWeek}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsWeek}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Week" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Style="{StaticResource PeriodItem}">
                        <Label Text="{loc:Extension '30 дней'}" FontSize="13" TextColor="{DynamicResource InkMuted}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMonth}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsMonth}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="Month" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Style="{StaticResource PeriodItem}">
                        <Label Text="{loc:Extension 'Всё время'}" FontSize="13" TextColor="{DynamicResource InkMuted}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAllTime}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAllTime}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPeriodCommand}" CommandParameter="AllTime" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </Border>

            <controls:SignalButton Grid.Column="2" Icon="refresh" Text="{loc:Extension 'Обновить'}" Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Six figures -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Extension 'Выполнено за неделю'}" Style="{StaticResource MetricCaption}" />
                    <Label Text="{Binding CompletedLastWeek}" Style="{StaticResource MetricValue}" />
                    <Label Text="{loc:Extension 'последние 7 суток'}" Style="{StaticResource MetricNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Extension 'Выполнено за месяц'}" Style="{StaticResource MetricCaption}" />
                    <Label Text="{Binding CompletedLastMonth}" Style="{StaticResource MetricValue}" />
                    <Label Text="{loc:Extension 'последние 30 суток'}" Style="{StaticResource MetricNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MetricTile}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Extension 'Вовремя'}" Style="{StaticResource MetricCaption}" />
                    <Label Text="{Binding OnTimeText}" Style="{StaticResource MetricValue}" />
                    <Label Text="{Binding OnTimeNote}" Style="{StaticResource MetricNote}" />
                    <controls:Segments Count="5" Filled="{Binding OnTimeBlocks}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource MetricTile}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Extension 'Среднее время'}" Style="{StaticResource MetricCaption}" />
                    <Label Text="{Binding AverageText}" Style="{StaticResource MetricValue}" />
                    <Label Text="{loc:Extension 'от создания до выполнения'}" Style="{StaticResource MetricNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Extension 'Просрочено'}" Style="{StaticResource MetricCaption}" />
                    <Label Text="{Binding OverdueCount}" Style="{StaticResource MetricValue}">
                        <Label.Triggers>
                            <!-- Overdue tasks are highlighted in red while there are any -->
                            <DataTrigger TargetType="Label" Binding="{Binding HasOverdue}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource PCrit}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{loc:Extension 'открытые с дедлайном в прошлом'}" Style="{StaticResource MetricNote}" />
                    <Label Text="{loc:Extension 'Показать в списке →'}" FontSize="11" TextColor="{DynamicResource Accent}" Margin="0,4,0,0">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowOverdueCommand}" /></Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="5" Style="{StaticResource MetricTile}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Extension 'Заблокировано'}" Style="{StaticResource MetricCaption}" />
                    <Label Text="{Binding BlockedCount}" Style="{StaticResource MetricValue}" />
                    <Label Text="{loc:Extension 'ждут выполнения зависимостей'}" Style="{StaticResource MetricNote}" />
                    <Label Text="{loc:Extension 'Показать в списке →'}" FontSize="11" TextColor="{DynamicResource Accent}" Margin="0,4,0,0">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowBlockedCommand}" /></Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Three panels: priorities, done by day, deadlines for 7 days -->
        <Grid x:Name="ChartsRow" Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Extension 'Открытые по приоритетам'}" Style="{StaticResource PanelTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bars}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PriorityBarViewModel">
                                <Grid ColumnDefinitions="108,*,24,36" ColumnSpacing="10">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <controls:PriorityBars Level="{Binding Level}" Color="{Binding Color}" />
                                        <Label Text="{Binding Title}" FontSize="11" TextColor="{Binding Color}"
                                               CharacterSpacing="0.4" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <controls:BarMeter Grid.Column="1" Fraction="{Binding Fraction}" FillColor="{Binding Color}" />
                                    <Label Grid.Column="2" Text="{Binding Count}" Style="{StaticResource ChartValue}"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Percent}" Style="{StaticResource MonoLabel}"
                                           FontSize="11" CharacterSpacing="0" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Extension 'Выполнено по дням'}" Style="{StaticResource PanelTitle}" />
                    <controls:DayChart Columns="{Binding CompletedColumns}" />
                    <Label Text="{Binding CompletedHint}" Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0" TextTransform="None" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="DeadlinesPanel" Grid.Column="2" Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Extension 'Дедлайны на 7 дней'}" Style="{StaticResource PanelTitle}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding DeadlineColumns}" Direction="Row" AlignItems="End" HeightRequest="128">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChartColumnViewModel">
                                <VerticalStackLayout FlexLayout.Grow="1" FlexLayout.Basis="0" Spacing="4" VerticalOptions="End" Margin="2,0">
                                    <Label Text="{Binding Value}" Style="{StaticResource ChartValue}" TextColor="{Binding ValueColor}" />
                                    <Border HeightRequest="78" StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{DynamicResource SurfaceRaised}">
                                        <BoxView VerticalOptions="End" HeightRequest="{Binding Height}" Color="{Binding Color}" />
                                    </Border>
                                    <Label Text="{Binding Label}" FontSize="10" TextColor="{DynamicResource InkMuted}"
                                           HorizontalTextAlignment="Center" LineBreakMode="NoWrap" HeightRequest="16" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="{Binding DeadlinesHint}" Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0" TextTransform="None" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Two panels: statuses and tags -->
        <Grid x:Name="BottomRow" Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Extension 'Открытые по статусам'}" Style="{StaticResource PanelTitle}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding StatusSegments}" Direction="Row" HeightRequest="18">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusSegmentViewModel">
                                <BoxView FlexLayout.Grow="{Binding Weight}" FlexLayout.Basis="0" Color="{Binding Color}"
                                         CornerRadius="2" Margin="1.5,0" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <FlexLayout BindableLayout.ItemsSource="{Binding StatusSegments}" Direction="Row" Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusSegmentViewModel">
                                <HorizontalStackLayout Spacing="6" Margin="0,0,18,0">
                                    <controls:Icon Kind="{Binding Icon}" Size="14" Color="{Binding Color}" VerticalOptions="Center" />
                                    <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Color}" VerticalOptions="Center" />
                                    <Label Text="{Binding Count}" Style="{StaticResource ChartValue}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Extension 'Теги в открытых задачах'}" Style="{StaticResource PanelTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tags}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagBarViewModel">
                                <Grid ColumnDefinitions="110,*,24" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           TextColor="{DynamicResource InkMuted}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <controls:BarMeter Grid.Column="1" Fraction="{Binding Fraction}" FillColor="{DynamicResource Accent}" HeightRequest="6" />
                                    <Label Grid.Column="2" Text="{Binding Count}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
