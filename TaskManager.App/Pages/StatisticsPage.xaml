<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             x:Class="TaskManager.App.Pages.StatisticsPage"
             x:DataType="vm:StatisticsViewModel"
             Title="Статистика">

    <ContentPage.Resources>
        <!-- Карточка с цифрой -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="WidthRequest" Value="215" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="10" />
            </Setter>
        </Style>
        <Style x:Key="BigNumber" TargetType="Label">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="CardCaption" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        </Style>
        <Style x:Key="CardNote" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10" MaximumWidthRequest="1000" HorizontalOptions="Start">

            <HorizontalStackLayout Spacing="16">
                <Label Text="Сводка" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                <Button Text="⟳ Обновить" Command="{Binding RefreshCommand}" Padding="12,2" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Пока нет данных: создайте и выполните несколько задач."
                   IsVisible="{Binding IsEmpty}"
                   TextColor="{StaticResource Gray500}" />

            <FlexLayout Wrap="Wrap" Margin="0,6,0,0">
                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CompletedLastWeek}" Style="{StaticResource BigNumber}" />
                        <Label Text="Выполнено за неделю" Style="{StaticResource CardCaption}" />
                        <Label Text="последние 7 суток" Style="{StaticResource CardNote}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding CompletedLastMonth}" Style="{StaticResource BigNumber}" />
                        <Label Text="Выполнено за месяц" Style="{StaticResource CardCaption}" />
                        <Label Text="последние 30 суток" Style="{StaticResource CardNote}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding OnTimeText}" Style="{StaticResource BigNumber}" />
                        <Label Text="Выполнено вовремя" Style="{StaticResource CardCaption}" />
                        <Label Text="{Binding OnTimeNote}" Style="{StaticResource CardNote}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding AverageText}" Style="{StaticResource BigNumber}" />
                        <Label Text="Среднее время выполнения" Style="{StaticResource CardCaption}" />
                        <Label Text="от создания до выполнения" Style="{StaticResource CardNote}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding OverdueCount}" Style="{StaticResource BigNumber}">
                            <Label.Triggers>
                                <!-- Просроченные задачи подсвечиваются красным, пока они есть -->
                                <DataTrigger TargetType="Label" Binding="{Binding HasOverdue}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Overdue}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Просрочено" Style="{StaticResource CardCaption}" />
                        <Label Text="открытые с прошедшим дедлайном" Style="{StaticResource CardNote}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding BlockedCount}" Style="{StaticResource BigNumber}" />
                        <Label Text="Заблокировано" Style="{StaticResource CardCaption}" />
                        <Label Text="ждут выполнения зависимостей" Style="{StaticResource CardNote}" />
                    </VerticalStackLayout>
                </Border>
            </FlexLayout>

            <!-- Гистограмма: открытые задачи по приоритетам -->
            <Label Text="Открытые задачи по приоритетам" FontSize="20" FontAttributes="Bold" Margin="0,10,0,4" />
            <Label Text="{Binding OpenCount, StringFormat='Всего открытых: {0}'}" Style="{StaticResource CardCaption}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bars}" Spacing="8" Margin="0,6,0,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriorityBarViewModel">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{Binding Title}" WidthRequest="120" VerticalOptions="Center" />
                            <BoxView Color="{Binding Color}" WidthRequest="{Binding Width}" HeightRequest="24" CornerRadius="4" VerticalOptions="Center" />
                            <Label Text="{Binding Count}" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
