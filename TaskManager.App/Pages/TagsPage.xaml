<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
             xmlns:loc="clr-namespace:TaskManager.App.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             x:Class="TaskManager.App.Pages.TagsPage"
             x:DataType="vm:TagsViewModel"
             Title="{loc:Extension 'Теги'}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14" Padding="28,20,28,14">

        <Grid Grid.Row="0" ColumnDefinitions="*,240,Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="{loc:Extension 'Теги'}" FontSize="30" FontAttributes="Bold" />
                <Label Text="{Binding SubtitleText}" Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0.7" />
            </VerticalStackLayout>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="10,0" HeightRequest="34" VerticalOptions="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:Icon Grid.Column="0" Kind="search" Size="15" Color="{DynamicResource InkMuted}" />
                    <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="{loc:Extension 'Найти тег'}" FontSize="13"
                           VerticalOptions="Center" MinimumHeightRequest="0" BackgroundColor="Transparent" />
                </Grid>
            </Border>

            <controls:SignalButton Grid.Column="2" Variant="Danger" Icon="trash" Text="{loc:Extension 'Удалить выбранные'}"
                                   Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16" Padding="0" VerticalOptions="Start">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" BackgroundColor="{DynamicResource Side}" HeightRequest="32" Padding="14,0" ColumnSpacing="10"
                      ColumnDefinitions="28,*,220,280">
                    <!-- Select all -->
                    <Border Grid.Column="0" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 4" StrokeThickness="1.6"
                            Stroke="{DynamicResource InkMutedBrush}" BackgroundColor="Transparent"
                            HorizontalOptions="Start" VerticalOptions="Center" IsVisible="{Binding HasDeletable}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AllSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSelectAllCommand}" />
                        </Border.GestureRecognizers>
                        <controls:Icon Kind="check" Size="14" Color="{DynamicResource OnAccent}" IsVisible="{Binding AllSelected}" />
                    </Border>
                    <Label Grid.Column="1" Text="{loc:Extension 'Тег'}" Style="{StaticResource MonoLabel}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{loc:Extension 'Задач'}" Style="{StaticResource MonoLabel}" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>

                <ScrollView Grid.Row="1">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.EmptyView>
                        <Label Text="{loc:Extension 'Тегов нет'}" HorizontalOptions="Center" Margin="0,28" Style="{StaticResource CaptionLabel}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagRowViewModel">
                            <Grid MinimumHeightRequest="40" Padding="14,4" ColumnSpacing="10" ColumnDefinitions="28,*,220,280">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <!-- Selection check box (only an unused tag can be selected) -->
                                <Border Grid.Column="0" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 4" StrokeThickness="1.6"
                                        Stroke="{DynamicResource InkMutedBrush}" BackgroundColor="Transparent"
                                        HorizontalOptions="Start" VerticalOptions="Center" IsVisible="{Binding CanSelect}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=ToggleSelectCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <controls:Icon Kind="check" Size="14" Color="{DynamicResource OnAccent}" IsVisible="{Binding IsSelected}" />
                                </Border>

                                <!-- Normal view -->
                                <Label Grid.Column="1" Text="{Binding DisplayName}" IsVisible="{Binding IsNotEditing}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="2" Spacing="10" IsVisible="{Binding IsNotEditing}" VerticalOptions="Center">
                                    <controls:BarMeter Fraction="{Binding Fraction}" FillColor="{DynamicResource Accent}" HeightRequest="6" WidthRequest="170" />
                                    <Label Text="{Binding TaskCount}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                           WidthRequest="24" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="End" VerticalOptions="Center" IsVisible="{Binding IsNotEditing}">
                                    <controls:SignalButton Variant="Ghost" Icon="edit" Text="{loc:Extension 'Переименовать'}" Compact="True"
                                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=StartEditCommand}"
                                                           CommandParameter="{Binding .}" />
                                    <controls:SignalButton Icon="trash" Text="{loc:Extension 'Удалить'}" Compact="True" Variant="Ghost" IsEnabled="{Binding CanDelete}"
                                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=DeleteCommand}"
                                                           CommandParameter="{Binding .}">
                                        <controls:SignalButton.Triggers>
                                            <DataTrigger TargetType="controls:SignalButton" Binding="{Binding CanDelete}" Value="True">
                                                <Setter Property="Variant" Value="Danger" />
                                            </DataTrigger>
                                        </controls:SignalButton.Triggers>
                                    </controls:SignalButton>
                                </HorizontalStackLayout>

                                <!-- Edit -->
                                <controls:InputBox Grid.Column="1" IsVisible="{Binding IsEditing}" HeightRequest="30">
                                    <Entry Text="{Binding EditName}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontAttributes="Bold"
                                           VerticalOptions="Center" MinimumHeightRequest="0" BackgroundColor="Transparent"
                                           ReturnCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=SaveEditCommand}"
                                           ReturnCommandParameter="{Binding .}" />
                                </controls:InputBox>
                                <Label Grid.Column="2" Text="{Binding EditHint}" IsVisible="{Binding IsEditing}"
                                       Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0" TextTransform="None" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="End" VerticalOptions="Center" IsVisible="{Binding IsEditing}">
                                    <controls:SignalButton Variant="Primary" Text="{loc:Extension 'Сохранить'}" Compact="True"
                                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=SaveEditCommand}"
                                                           CommandParameter="{Binding .}" />
                                    <controls:SignalButton Text="{loc:Extension 'Отмена'}" Compact="True"
                                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TagsViewModel}}, Path=CancelEditCommand}"
                                                           CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                                <BoxView Grid.ColumnSpan="4" VerticalOptions="End" HeightRequest="1" Margin="-14,0" Color="{DynamicResource Line}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <Label Grid.Row="2" Text="{loc:Extension 'Переименование меняет тег во всех задачах. Удалить можно только тег, который не используется.'}"
               Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0" TextTransform="None" />
    </Grid>
</ContentPage>
