<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
             xmlns:loc="clr-namespace:TaskManager.App.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             x:Class="TaskManager.App.Pages.TaskDetailsPage"
             x:DataType="vm:TaskDetailsViewModel"
             Shell.BackButtonBehavior="{BackButtonBehavior IsVisible=False}"
             Title="{loc:Extension 'Задача'}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,340" ColumnSpacing="20" RowSpacing="14" Padding="28,20,28,20">

            <!-- Breadcrumbs: ‹ Tasks / Parent / Title -->
            <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackToTasksCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <controls:Icon Kind="chevron-left" Size="14" Color="{DynamicResource InkMuted}" />
                    <Label Text="{loc:Extension 'Задачи'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource InkMuted}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="/" FontSize="13" TextColor="{DynamicResource InkMuted}" IsVisible="{Binding HasParent}" />
                <Label Text="{Binding ParentTitle}" FontSize="13" TextColor="{DynamicResource InkMuted}" IsVisible="{Binding HasParent}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenParentCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="/" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource InkMuted}" LineBreakMode="TailTruncation" MaximumWidthRequest="420" />
            </HorizontalStackLayout>

            <!-- Left column: title, details, description, subtasks, dependencies -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="14">

                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Title}" FontSize="30" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <Border StrokeShape="RoundRectangle 99" StrokeThickness="0" Padding="7,2,9,2" Margin="0,0,10,4"
                                BackgroundColor="{Binding StatusTint}">
                            <HorizontalStackLayout Spacing="5">
                                <controls:Icon Kind="{Binding StatusIcon}" Size="14" Color="{Binding StatusColor}" />
                                <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border StrokeShape="RoundRectangle 99" StrokeThickness="0" Padding="7,2,9,2" Margin="0,0,10,4"
                                BackgroundColor="{Binding PriorityTint}">
                            <HorizontalStackLayout Spacing="5">
                                <controls:PriorityBars Level="{Binding PriorityLevel}" Color="{Binding PriorityColor}" />
                                <Label Text="{Binding PriorityText}" TextColor="{Binding PriorityColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <HorizontalStackLayout Spacing="5" Margin="0,0,10,4" IsVisible="{Binding HasDeadlineChip}">
                            <controls:Icon Kind="calendar" Size="13" Color="{DynamicResource InkMuted}">
                                <controls:Icon.Triggers>
                                    <DataTrigger TargetType="controls:Icon" Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Color" Value="{DynamicResource PCrit}" />
                                    </DataTrigger>
                                </controls:Icon.Triggers>
                            </controls:Icon>
                            <Label Text="{Binding DeadlineChipText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   TextColor="{DynamicResource InkMuted}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource PCrit}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <Label Text="{Binding TagsText}" IsVisible="{Binding HasTags}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           TextColor="{DynamicResource InkMuted}" />
                    <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextColor="{DynamicResource InkMuted}" MaximumWidthRequest="640" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Subtasks -->
                <VerticalStackLayout IsVisible="{Binding HasSubtasks}" Spacing="4">
                    <HorizontalStackLayout Spacing="10" Margin="0,0,0,4">
                        <Label Text="{loc:Extension 'Подзадачи'}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border StrokeShape="RoundRectangle 9" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceRaised}" Padding="6,0" VerticalOptions="Center">
                            <Label Text="{Binding SubtasksCountText}" FontSize="11" FontAttributes="Bold" />
                        </Border>
                        <Grid WidthRequest="90" HeightRequest="5" VerticalOptions="Center">
                            <BoxView Color="{DynamicResource Line}" CornerRadius="3" />
                            <BoxView Color="{DynamicResource Accent}" CornerRadius="3" WidthRequest="{Binding SubtasksBarWidth}" HorizontalOptions="Start" />
                        </Grid>
                        <controls:SignalButton Variant="Ghost" Icon="plus" Text="{loc:Extension 'Добавить'}" Command="{Binding AddSubtaskCommand}" Compact="True" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Subtasks}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubtaskRowViewModel">
                                <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="12,8" Margin="{Binding Indent}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="16" HeightRequest="16" StrokeShape="RoundRectangle 4" StrokeThickness="1.6"
                                                Stroke="{DynamicResource InkMutedBrush}" BackgroundColor="Transparent" VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource SDone}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource SDoneBrush}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskDetailsViewModel}}, Path=ToggleSubtaskCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <controls:Icon Kind="check" Size="14" Color="#FFFFFF" IsVisible="{Binding IsDone}" />
                                        </Border>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" TextDecorations="{Binding TitleDecorations}" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsClosed}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding ProgressText}" IsVisible="{Binding HasProgress}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" TextColor="{DynamicResource InkMuted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                            <controls:Icon Kind="{Binding StatusIcon}" Size="14" Color="{Binding StatusColor}" />
                                            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="5" VerticalOptions="Center" IsVisible="{Binding HasDeadline}">
                                            <controls:Icon Kind="calendar" Size="13" Color="{DynamicResource InkMuted}" />
                                            <Label Text="{Binding DeadlineText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextColor="{DynamicResource InkMuted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Dependencies -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Extension 'Зависимости'}" FontSize="15" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="84,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{loc:Extension 'Зависит от'}" FontSize="12" TextColor="{DynamicResource InkMuted}" VerticalOptions="Start" Margin="0,10,0,0" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DependsOn}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DependencyRowViewModel">
                                        <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="12,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                <controls:Icon Grid.Column="0" Kind="link" Size="14" Color="{DynamicResource InkMuted}" />
                                                <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                                    <controls:Icon Kind="{Binding StatusIcon}" Size="14" Color="{Binding StatusColor}" />
                                                    <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <controls:Icon Grid.Column="3" Kind="x" Size="14" Color="{DynamicResource InkMuted}" IsVisible="{Binding CanRemove}" InputTransparent="False">
                                                    <controls:Icon.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RemoveCommand}" />
                                                    </controls:Icon.GestureRecognizers>
                                                </controls:Icon>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{loc:Extension 'Зависимостей нет.'}" IsVisible="{Binding HasNoDependsOn}" FontSize="13" TextColor="{DynamicResource InkMuted}" Margin="0,10,0,0" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="84,*" ColumnSpacing="10" IsVisible="{Binding HasBlocks}">
                        <Label Grid.Column="0" Text="{loc:Extension 'Блокирует'}" FontSize="12" TextColor="{DynamicResource InkMuted}" VerticalOptions="Start" Margin="0,10,0,0" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6" BindableLayout.ItemsSource="{Binding Blocks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DependencyRowViewModel">
                                    <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="12,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <controls:Icon Grid.Column="0" Kind="link" Size="14" Color="{DynamicResource InkMuted}" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                                <controls:Icon Kind="{Binding StatusIcon}" Size="14" Color="{Binding StatusColor}" />
                                                <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <!-- A task list in the style of the application (the system Picker opened a Windows window that is not in our theme) -->
                        <controls:DropField Grid.Column="0" HeightRequest="34" ItemsSource="{Binding DependencyCandidates}"
                                            SelectedItem="{Binding SelectedCandidate}" Placeholder="{loc:Extension 'Добавить зависимость…'}" />
                        <controls:SignalButton Grid.Column="1" Variant="Secondary" Text="{loc:Extension 'Добавить'}" Command="{Binding AddDependencyCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Right column: actions, properties, history -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="12">

                <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <controls:SignalButton Variant="{Binding PrimaryAction.Variant}" Icon="{Binding PrimaryAction.Icon}" Text="{Binding PrimaryAction.Title}"
                                               Command="{Binding PrimaryAction.Command}" IsEnabled="{Binding PrimaryAction.IsEnabled}"
                                               IsVisible="{Binding HasPrimaryAction}" HorizontalOptions="Fill" HeightRequest="42" />
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasPrimaryReason}" Margin="0,-4,0,0">
                            <controls:Icon Kind="blocked" Size="12" Color="{DynamicResource InkMuted}" />
                            <Label Text="{Binding PrimaryReason}" FontSize="12" TextColor="{DynamicResource InkMuted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Grid x:Name="SecondaryGrid" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8" />

                        <BoxView HeightRequest="1" />
                        <Grid ColumnDefinitions="*,Auto">
                            <controls:SignalButton Grid.Column="0" Variant="Ghost" Icon="{Binding CancelAction.Icon}" Text="{Binding CancelAction.Title}"
                                                   Command="{Binding CancelAction.Command}" IsVisible="{Binding HasCancelAction}" />
                            <controls:SignalButton Grid.Column="1" Variant="Ghost" Icon="trash" Text="{loc:Extension 'Удалить'}" Command="{Binding DeleteCommand}" HorizontalOptions="End">
                            </controls:SignalButton>
                        </Grid>
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="20" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Extension 'Свойства'}" Style="{StaticResource MonoLabel}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <Label Grid.Row="0" Text="{loc:Extension 'Статус'}" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                <controls:Icon Kind="{Binding StatusIcon}" Size="14" Color="{Binding StatusColor}" />
                                <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{loc:Extension 'Приоритет'}" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                <controls:PriorityBars Level="{Binding PriorityLevel}" Color="{Binding PriorityColor}" />
                                <Label Text="{Binding PriorityText}" TextColor="{Binding PriorityColor}" FontSize="13" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="2" Text="{loc:Extension 'Дедлайн'}" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DeadlineValueText}" FontSize="13" FontAttributes="Bold" />
                            <Label Grid.Row="3" Text="{loc:Extension 'Повторение'}" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding RecurrenceValueText}" FontSize="13" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Grid.Row="4" Text="{loc:Extension 'Создана'}" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding CreatedText}" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Extension 'История'}" Style="{StaticResource MonoLabel}" FontAttributes="Bold" Margin="0,0,0,4" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                    <Grid ColumnDefinitions="14,78,*" ColumnSpacing="8" Padding="0,5">
                                        <BoxView Grid.Column="0" WidthRequest="2" HorizontalOptions="Center" VerticalOptions="Fill" Margin="0,16,0,-5" Color="{DynamicResource Line}" />
                                        <Border Grid.Column="0" WidthRequest="9" HeightRequest="9" StrokeShape="RoundRectangle 12" StrokeThickness="2"
                                                Stroke="{DynamicResource AccentBrush}" BackgroundColor="{DynamicResource Surface}"
                                                VerticalOptions="Start" Margin="0,5,0,0" />
                                        <Label Grid.Column="1" Text="{Binding When}" FontSize="13" TextColor="{DynamicResource InkMuted}" />
                                        <Label Grid.Column="2" FontSize="13" LineBreakMode="WordWrap">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Prefix}" />
                                                    <Span Text="{Binding Value}" FontAttributes="Bold" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
