<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
             xmlns:loc="clr-namespace:TaskManager.App.Services" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             x:Class="TaskManager.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Extension 'Настройки'}">

    <ContentPage.Resources>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="Label" BasedOn="{StaticResource MonoLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.6" />
        </Style>
        <Style x:Key="SettingName" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="SettingHint" TargetType="Label" BasedOn="{StaticResource MicroLabel}" />
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto" RowSpacing="14" Padding="28,20,28,14">

            <VerticalStackLayout Grid.Row="0">
                <Label Text="{loc:Extension 'Настройки'}" FontSize="20" FontAttributes="Bold" TextTransform="Uppercase" CharacterSpacing="1.6" />
                <Label Text="{loc:Extension 'Изменения применяются сразу'}" Style="{StaticResource MonoLabel}" FontSize="11" CharacterSpacing="0.7" />
            </VerticalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Список -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Extension 'Список'}" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Задач на странице'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Сколько строк показывать до пейджера'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:SegmentedChoice Grid.Column="1" Items="{Binding PageSizeItems}" SelectedIndex="{Binding PageSizeIndex}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Скрывать закрытые'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Выполненные и отменённые не показываются по умолчанию'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:SwitchToggle Grid.Column="1" IsOn="{Binding HideClosed}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Оформление -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Extension 'Оформление'}" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Тема'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Цветовая тема интерфейса'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:DropField Grid.Column="1" WidthRequest="190" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedTheme}"
                                                Swatches="{Binding ThemeSwatches}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Вид по умолчанию'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Что открывается при запуске'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:SegmentedChoice Grid.Column="1" Items="{loc:Extension 'Доска|Список'}" SelectedIndex="{Binding DefaultViewIndex}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Язык'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Язык интерфейса'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:DropField Grid.Column="1" WidthRequest="150" ItemsSource="{Binding LanguageNames}" SelectedItem="{Binding SelectedLanguage}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Напоминания -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Extension 'Напоминания'}" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Проверять каждые'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Как часто искать приближающиеся дедлайны'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:DropField Grid.Column="1" WidthRequest="130" ItemsSource="{Binding ReminderOptions}" SelectedItem="{Binding SelectedReminder}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Баннер в боковой панели'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Список напоминаний внизу навигации'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:SwitchToggle Grid.Column="1" IsOn="{Binding ShowBanner}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{loc:Extension 'Уведомления Windows'}" Style="{StaticResource SettingName}" />
                                <Label Text="{loc:Extension 'Показывать системное уведомление'}" Style="{StaticResource SettingHint}" />
                            </VerticalStackLayout>
                            <controls:SwitchToggle Grid.Column="1" IsOn="{Binding ShowWindowsToast}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Данные -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Extension 'Данные'}" Style="{StaticResource PanelTitle}" Margin="0,0,0,2" />
                        <Label Text="{loc:Extension 'Путь к базе'}" Style="{StaticResource MonoLabel}" FontSize="11" FontAttributes="Bold" />
                        <Border Style="{StaticResource CardBorder}" StrokeShape="RoundRectangle 5" Padding="10,8" BackgroundColor="{DynamicResource Surface}">
                            <Label Text="{Binding DatabasePath}" FontFamily="{StaticResource MonoFont}" FontSize="12" LineBreakMode="CharacterWrap" />
                        </Border>
                        <controls:SignalButton Text="{loc:Extension 'Показать в папке'}" Compact="True" Command="{Binding RevealDatabaseCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Горячие клавиши -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Extension 'Горячие клавиши'}" Style="{StaticResource PanelTitle}" />
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="{loc:Extension 'Новая задача'}" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyCap}"><Label Text="{loc:Extension 'Ctrl N'}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextColor="{DynamicResource InkMuted}" /></Border>
                            <Label Grid.Row="0" Grid.Column="2" Text="{loc:Extension 'Поиск'}" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource KeyCap}"><Label Text="{loc:Extension 'Ctrl K'}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextColor="{DynamicResource InkMuted}" /></Border>
                            <Label Grid.Row="0" Grid.Column="4" Text="{loc:Extension 'Сохранить'}" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource KeyCap}"><Label Text="{loc:Extension 'Ctrl Enter'}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextColor="{DynamicResource InkMuted}" /></Border>
                            <Label Grid.Row="1" Grid.Column="0" Text="{loc:Extension 'Отмена'}" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyCap}"><Label Text="Esc" FontFamily="{StaticResource MonoFont}" FontSize="11" TextColor="{DynamicResource InkMuted}" /></Border>
                            <Label Grid.Row="1" Grid.Column="2" Text="{loc:Extension 'Выполнить'}" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource KeyCap}"><Label Text="{loc:Extension 'Ctrl D'}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextColor="{DynamicResource InkMuted}" /></Border>
                            <Label Grid.Row="1" Grid.Column="4" Text="{loc:Extension 'Назад'}" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource KeyCap}"><Label Text="Alt ←" FontFamily="{StaticResource MonoFont}" FontSize="11" TextColor="{DynamicResource InkMuted}" /></Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
