<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             x:Class="TaskManager.App.Controls.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <!-- Боковая панель Signal: марка, разделы с горячими клавишами, напоминания внизу. -->
    <Grid BackgroundColor="{DynamicResource Side}" RowDefinitions="Auto,Auto,*,Auto" Padding="8,10,8,10">

        <Label Grid.Row="0" Margin="12,12,0,18" Style="{StaticResource MonoLabel}"
               TextColor="{DynamicResource Ink}" FontSize="12" FontAttributes="Bold" CharacterSpacing="2.5">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="TASK" />
                    <Span Text="/" TextColor="{DynamicResource Accent}" />
                    <Span Text="MANAGER" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <VerticalStackLayout Grid.Row="1" Spacing="2" BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                    <VerticalStackLayout>
                        <BoxView HeightRequest="1" Margin="4,8,4,8" IsVisible="{Binding SeparatorAbove}" />

                        <Border x:Name="Row" Padding="10,8" BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 6">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SidebarViewModel}}, Path=OpenCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <controls:Icon Grid.Column="0" Kind="{Binding Icon}" Size="18" Color="{DynamicResource InkMuted}">
                                    <controls:Icon.Triggers>
                                        <DataTrigger TargetType="controls:Icon" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Color" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </controls:Icon.Triggers>
                                </controls:Icon>
                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="13" TextColor="{DynamicResource InkMuted}"
                                       FontAttributes="None" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="2" Text="{Binding Count}" IsVisible="{Binding HasCount}"
                                       FontSize="12" TextColor="{DynamicResource InkMuted}" VerticalOptions="Center" />
                                <Border Grid.Column="3" Padding="5,0" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                    <Label Text="{Binding Hint}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           TextColor="{DynamicResource InkMuted}" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <controls:ReminderBanner Grid.Row="3" />
    </Grid>

</ContentView>
