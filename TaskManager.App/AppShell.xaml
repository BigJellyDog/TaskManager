<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TaskManager.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TaskManager.App.Pages"
    xmlns:controls="clr-namespace:TaskManager.App.Controls"
    Title="TaskManager"
    FlyoutBehavior="Locked">

    <!-- Баннер напоминаний внизу боковой панели: виден на любом экране -->
    <Shell.FlyoutFooter>
        <controls:ReminderBanner />
    </Shell.FlyoutFooter>

    <!-- Постоянная боковая панель навигации. Страницы создаются через DI, поэтому принимают зависимости в конструкторе. -->
    <ShellContent
        Title="Задачи"
        ContentTemplate="{DataTemplate pages:TasksPage}"
        Route="tasks" />

    <ShellContent
        Title="Статистика"
        ContentTemplate="{DataTemplate pages:StatisticsPage}"
        Route="statistics" />

    <ShellContent
        Title="Данные"
        ContentTemplate="{DataTemplate pages:DataPage}"
        Route="data" />

</Shell>
