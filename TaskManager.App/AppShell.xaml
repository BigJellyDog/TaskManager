<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TaskManager.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TaskManager.App.Pages"
    xmlns:controls="clr-namespace:TaskManager.App.Controls"
    Title="TaskManager"
    FlyoutBehavior="Locked"
    FlyoutWidth="207"
    FlyoutBackgroundColor="{DynamicResource Side}">

    <!-- Постоянная боковая панель Signal: разделы, счётчики и напоминания -->
    <Shell.FlyoutContent>
        <controls:SidebarView />
    </Shell.FlyoutContent>

    <!-- Страницы создаются через DI, поэтому принимают зависимости в конструкторе. -->
    <ShellContent ContentTemplate="{DataTemplate pages:TasksPage}" Route="tasks" />
    <ShellContent ContentTemplate="{DataTemplate pages:StatisticsPage}" Route="statistics" />
    <ShellContent ContentTemplate="{DataTemplate pages:DataPage}" Route="data" />
    <ShellContent ContentTemplate="{DataTemplate pages:SoonPage}" Route="trash" />
    <ShellContent ContentTemplate="{DataTemplate pages:SoonPage}" Route="tags" />
    <ShellContent ContentTemplate="{DataTemplate pages:SoonPage}" Route="settings" />

</Shell>
